{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var forecast \App\Entity\Forecast[] #}

{% block title %}Weather in {{ location.name }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.name }}, {{ location.country }}</h1>

        <ul>
            {% for x in forecast %}
                <li>
                    <strong>{{ x.Date|date('d.m.Y') }}</strong> —
                    Temp: {{ x.Temperature }}&deg;C,
                    Wiatr: {{ x.Wind }} km/h,
                    Wilgotność: {{ x.Humidity }}%,
                    Opady: {{ x.Precipitation }} mm
                </li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
