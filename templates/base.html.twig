<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}W App{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=57932");
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand bg-body-tertiary mb-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="#">W App</a>

        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_location_index') }}">Cities</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_forecast_index') }}">Forecasts</a>
            </li>
        </ul>
    </div>
</nav>

<div class="container">
    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
